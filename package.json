{
  "name": "voicesum-bot",
  "version": "1.1.0",
  "description": "Telegram bot: formats messy pasted text into RTL Persian Word docs, and transcribes/summarizes long voice messages (VoiceSum) with optional Word export",
  "main": "src/bot.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/bot.js"
  },
  "dependencies": {
    "docx": "^9.0.0",
    "dotenv": "^16.4.5",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "node-telegram-bot-api": "^0.66.0",
    "pdf-parse": "^1.1.1",
    "sharp": "^0.33.5"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "sharp@0.33.5": true
  }
}
