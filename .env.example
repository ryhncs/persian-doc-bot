# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Groq API key (console.groq.com) — used for Whisper transcription and Llama summarization
GROQ_API_KEY=

# Leave unset for polling mode (default, works anywhere). Set to your public
# HTTPS base URL (no trailing slash, e.g. https://your-app.up.railway.app or
# your Runflare/Liara domain) to switch the bot to webhook mode.
WEBHOOK_URL=

# Port the bot listens on in webhook mode (ignored in polling mode)
PORT=3000

# Groq models
WHISPER_MODEL=whisper-large-v3
SUMMARY_MODEL=openai/gpt-oss-120b

# Reject voice messages longer than this (seconds)
MAX_VOICE_DURATION_SECONDS=600

# Reject voice messages shorter than this (seconds) — Whisper is unreliable
# on very short clips regardless of prompt/language/temperature tuning
MIN_VOICE_DURATION_SECONDS=4

# Max voice messages a single user can process per day (in-memory MVP limit)
DAILY_VOICE_LIMIT_PER_USER=20

# Ghostscript PDFSETTINGS preset for PDF compression. Other options:
# /screen (smallest, lowest quality), /printer, /prepress (largest, closest to original)
PDF_COMPRESS_PRESET=/ebook

# Upper bound on the extracted text of one PDF to summarize. Long PDFs are
# split into chunks and summarized in turn, never truncated, but it takes about
# a minute per 5,000 characters, so anything longer than this gets a friendly
# "send it in parts" reply.
MAX_DOCUMENT_CHARS_FOR_SUMMARY=40000

# Groq tokens-per-minute limit for SUMMARY_MODEL on your plan. Chunk sizes and
# request pacing for long PDFs are derived from it.
GROQ_TPM_LIMIT=6000

# --- Monetization (free weekly quota + manual card-to-card subscription) ---
# Enforcement turns on only when ALL FIVE of these are set; otherwise the bot
# logs which are missing and every feature stays unlimited.

# Supabase project URL (just https://<project-ref>.supabase.co, no path) and the
# *service_role* key (Project Settings -> API).
# Server-side only -- never expose this key. Run supabase/schema.sql once first.
SUPABASE_URL=
SUPABASE_KEY=

# Monthly subscription price in Toman (digits only, e.g. 120000) and the card
# number users transfer to.
SUBSCRIPTION_PRICE_TOMAN=
CARD_NUMBER=

# Where payment receipts are sent for approval: your Telegram user id (message
# @userinfobot to find it) or a group chat id. The admin must press Start on the
# bot once, or Telegram won't let the bot message them.
ADMIN_CHAT_ID=

# Optional: shown to users whose payment was rejected (e.g. @your_username).
ADMIN_CONTACT=

# Free premium requests (voice/PDF summary, translate) per user per rolling 7 days.
FREE_REQUESTS_PER_WEEK=3
